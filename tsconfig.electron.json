{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist/electron",
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": ["electron/**/*", "src/core/**/*"],
  "exclude": ["node_modules", "dist", "src/ui"]
}
